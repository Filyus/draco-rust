# libFuzzer dictionary for the FBX reader and writer targets.
#
# FBX is two grammars behind one reader: a binary container whose node
# records carry a name, and an ASCII form where the same names are spelled out
# followed by `:`. Either way the reader dispatches on the node name, so a
# mutation that does not produce a whole name produces a node the reader skips.
# The names are the ones the reader matches on, taken from its own source; the
# ASCII entries carry their trailing `: ` or `: *` so that a token lands as a
# complete node head rather than a bare word inside a string.

# Binary container
"Kaydara FBX Binary  \x00\x1a\x00"
"\xe8\x1c\x00\x00"
"\x4c\x1d\x00\x00"

# ASCII container
"; FBX 7.4.0 project file"
"FBXHeaderExtension: {"
"FBXHeaderVersion: "
"FBXVersion: 7400"
"GlobalSettings: {"
"Definitions: {"
"ObjectType: "
"PropertyTemplate: "
"Objects: {"
"Connections: {"
"Takes: {"
"Version: "
"Count: "
"Name: "
"a: "
": *"
"{"
"}"
"::"
"&quot;"


# libFuzzer dictionary for the glTF targets.
#
# A glTF document is JSON, and the parser is driven by property names: a
# mutated key that is not one of them is an unknown property, which is
# accepted and ignored. Whole quoted keys let the mutator move a document from
# one shape to another in a single step -- an accessor gains a `sparse` block,
# a primitive gains a Draco extension -- instead of never getting there. The
# keys are the ones the crate reads, taken from its own source, with the
# quotes included so a token is a key and not a substring of a string value.
# Enumerated values are spelled the way the schema fixes them, and the GLB
# container's own markers are here so a JSON corpus can grow a binary chunk.

# GLB container
"glTF\x02\x00\x00\x00"
"JSON"
"BIN\x00"
"DRACO"

# Structure
"\"asset\""
"\"version\""
"\"2.0\""
"\"minVersion\""
"\"generator\""
"\"extensions\""
"\"extensionsUsed\""
"\"extensionsRequired\""
"\"extras\""
"\"name\""

# Buffers and accessors
"\"buffers\""
"\"buffer\""
"\"uri\""
"\"data:application/octet-stream;base64,"
"\"byteLength\""
"\"bufferViews\""
"\"bufferView\""
"\"byteOffset\""
"\"byteStride\""
"\"target\""
"\"accessors\""
"\"accessor\""
"\"componentType\""
"\"normalized\""
"\"count\""
"\"type\""
"\"SCALAR\""
"\"VEC2\""
"\"VEC3\""
"\"VEC4\""
"\"MAT2\""
"\"MAT3\""
"\"MAT4\""
"\"min\""
"\"max\""
"\"sparse\""
"\"indices\""
"\"values\""
"5120"
"5121"
"5122"
"5123"
"5125"
"5126"
"34962"
"34963"

# Meshes
"\"meshes\""
"\"mesh\""
"\"primitives\""
"\"attributes\""
"\"POSITION\""
"\"NORMAL\""
"\"TANGENT\""
"\"TEXCOORD_0\""
"\"TEXCOORD_1\""
"\"COLOR_0\""
"\"JOINTS_0\""
"\"WEIGHTS_0\""
"\"_CUSTOM\""
"\"mode\""
"\"material\""
"\"targets\""
"\"weights\""

# Extensions the crate reads
"\"KHR_draco_mesh_compression\""
"\"KHR_mesh_quantization\""
"\"KHR_materials_variants\""
"\"KHR_animation_pointer\""
"\"KHR_texture_basisu\""
"\"KHR_texture_transform\""
"\"EXT_meshopt_compression\""
"\"KHR_meshopt_compression\""
"\"mappings\""
"\"variants\""
"\"pointer\""
"\"fallback\""
"\"filter\""
"\"uid\""

# Scene graph
"\"scenes\""
"\"scene\""
"\"nodes\""
"\"node\""
"\"children\""
"\"translation\""
"\"rotation\""
"\"scale\""
"\"matrix\""
"\"skin\""
"\"skins\""
"\"joints\""
"\"skeleton\""
"\"inverseBindMatrices\""
"\"camera\""
"\"cameras\""

# Animation
"\"animations\""
"\"channels\""
"\"samplers\""
"\"sampler\""
"\"path\""
"\"input\""
"\"output\""
"\"interpolation\""
"\"LINEAR\""
"\"STEP\""
"\"CUBICSPLINE\""

# Materials and images
"\"materials\""
"\"textures\""
"\"texture\""
"\"images\""
"\"image\""
"\"source\""
"\"mimeType\""
"\"image/png\""
"\"image/jpeg\""
"\"image/ktx2\""

# JSON
"true"
"false"
"null"
"[]"
"{}"
"\":"
"\\u"
"-0"
"1e309"
"NaN"
